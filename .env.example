# ==========================================
# Family Feud Online - Unified Environment Configuration Template
# Single source of truth for Root, Backend, Frontend & Docker
# ==========================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=family_feud
MYSQL_USER=family-feud-user
MYSQL_PASSWORD=your_database_password_here
MYSQL_PORT=3306

# Database Connection URL (for Prisma outside Docker)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://family-feud-user:your_database_password_here@localhost:3306/family_feud"

# Backend Server Configuration
PORT=5000
BACKEND_PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Frontend Client Configuration (Vite & Docker)
FRONTEND_PORT=80
VITE_BACKEND_URL=http://localhost:5000
