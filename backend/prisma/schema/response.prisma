model PlayerResponse {
  id                  String   @id @default(uuid())
  questionId          String   @map("question_id")
  playerId            String   @map("player_id")
  rawInput            String   @map("raw_input") @db.VarChar(255)
  isMatched           Boolean  @default(false) @map("is_matched")
  matchedAnswerId     String?  @map("matched_answer_id")
  pointsAwarded       Int      @default(0) @map("points_awarded")
  responseTimeSeconds Decimal? @map("response_time_seconds") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  player              Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchedAnswer       Answer?  @relation(fields: [matchedAnswerId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([playerId])
  @@index([matchedAnswerId])
  @@map("player_responses")
}

