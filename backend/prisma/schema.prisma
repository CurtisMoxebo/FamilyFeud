datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  EN
  FR
  ES
}

enum GameMode {
  FAST_MONEY
  MAIN_GAME
}

enum RoomStatus {
  LOBBY
  ACTIVE
  FINISHED
}

enum Team {
  TEAM_1
  TEAM_2
  NONE
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
}

model Room {
  id        String     @id @default(uuid())
  roomCode  String     @unique @map("room_code") @db.VarChar(10)
  roomName  String     @map("room_name") @db.VarChar(100)
  language  Language   @default(EN)
  gameMode  GameMode   @map("game_mode")
  status    RoomStatus @default(LOBBY)
  createdAt DateTime   @default(now()) @map("created_at")

  players   Player[]
  games     Game[]

  @@map("rooms")
}

model Player {
  id          String   @id @default(uuid())
  roomId      String   @map("room_id")
  nickname    String   @db.VarChar(50)
  team        Team     @default(NONE)
  socketId    String?  @map("socket_id") @db.VarChar(100)
  isReady     Boolean  @default(false) @map("is_ready")
  totalScore  Int      @default(0) @map("total_score")
  isConnected Boolean  @default(true) @map("is_connected")
  createdAt   DateTime @default(now()) @map("created_at")

  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  responses   PlayerResponse[]

  @@index([roomId, isConnected])
  @@map("players")
}

model Game {
  id                     String     @id @default(uuid())
  roomId                 String     @map("room_id")
  mode                   GameMode
  status                 GameStatus @default(IN_PROGRESS)
  currentRound           Int        @default(1) @map("current_round")
  winnerTeam             String?    @map("winner_team") @db.VarChar(50)
  totalPointsAccumulated Int        @default(0) @map("total_points_accumulated")
  createdAt              DateTime   @default(now()) @map("created_at")

  room                   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questions              Question[]

  @@map("games")
}

model Question {
  id           String   @id @default(uuid())
  gameId       String   @map("game_id")
  roundNumber  Int      @map("round_number")
  orderIndex   Int      @default(1) @map("order_index")
  language     String   @db.VarChar(10)
  questionText String   @map("question_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  game         Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers      Answer[]
  responses    PlayerResponse[]

  @@index([gameId, roundNumber, orderIndex])
  @@map("questions")
}

model Answer {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  rankOrder  Int      @map("rank_order")
  answerText String   @map("answer_text") @db.VarChar(255)
  points     Int
  isRevealed Boolean  @default(false) @map("is_revealed")

  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  PlayerResponse[]

  @@index([questionId, rankOrder])
  @@map("answers")
}

model PlayerResponse {
  id                  String   @id @default(uuid())
  questionId          String   @map("question_id")
  playerId            String   @map("player_id")
  rawInput            String   @map("raw_input") @db.VarChar(255)
  isMatched           Boolean  @default(false) @map("is_matched")
  matchedAnswerId     String?  @map("matched_answer_id")
  pointsAwarded       Int      @default(0) @map("points_awarded")
  responseTimeSeconds Decimal? @map("response_time_seconds") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  player              Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchedAnswer       Answer?  @relation(fields: [matchedAnswerId], references: [id], onDelete: SetNull)

  @@map("player_responses")
}

