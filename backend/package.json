{
  "name": "family-feud-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API and WebSocket server for Family Feud Online",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs');if(fs.existsSync('dist/src')){fs.cpSync('dist/src','dist',{recursive:true});fs.rmSync('dist/src',{recursive:true,force:true});fs.rmSync('dist/tests',{recursive:true,force:true});}\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "node --env-file-if-exists=../.env --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate --schema=prisma/schema",
    "prisma:migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev --schema=prisma/schema",
    "prisma:studio": "node --env-file-if-exists=../.env --env-file-if-exists=.env ./node_modules/prisma/build/index.js studio --schema=prisma/schema",
    "prisma:deploy": "node --env-file-if-exists=../.env --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
